# =============================================================================
# DATA-SERVICE 2.0 — Environment Variable Reference
# Version: 2.0.0 | Port: 8200
#
# How to use:
#   Local development  → .env.local already ships with safe defaults.
#                        Edit provider credentials (Angel One, Upstox) before running.
#   Production         → cp .env.example .env.production
#                        Fill every field marked REQUIRED before deploying.
#   Docker Compose     → Always pass --env-file: docker compose --env-file .env.local up
#
# Variables marked REQUIRED have no safe default and MUST be set.
# Variables marked OPTIONAL are unused unless the corresponding feature is enabled.
# Never commit .env.production or any file containing real secrets to version control.
#
# Full configuration reference: docs/ARCHITECTURE.md#16-configuration-and-settings
# =============================================================================


# =============================================================================
# SERVER
# =============================================================================

# Port the FastAPI/Uvicorn process listens on inside the container.
# The docker-compose.yml maps this to the host as ${DATA_SERVICE_PORT}:8200.
# Default: 8200
DATA_SERVICE_PORT=8200

# Deployment environment.
# Controls /docs, /redoc, /openapi.json visibility (development/staging only)
# and log output format (JSON in production, human-readable in development).
# Values: development | staging | production
ENVIRONMENT=production

# Number of Uvicorn worker processes.
# Set to 1 for debugging (easier to attach a debugger to a single process).
# Production recommended: 2-4 (depends on available CPU cores).
UVICORN_WORKERS=4


# =============================================================================
# INFRASTRUCTURE
# =============================================================================

# Redis connection string.
# In Docker Compose the "redis" hostname resolves via the internal network.
# For local dev without Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# PostgreSQL async connection string. REQUIRED — no safe default.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# In Docker Compose, use the service name "postgres" as the host.
# For local dev without Docker: postgresql+asyncpg://mds_user:<password>@localhost:5444/mds
DATABASE_URL=

# PostgreSQL container credentials.
# POSTGRES_PASSWORD is REQUIRED — set a strong password before first deploy.
# These values are also used by the pg_isready health check in docker-compose.yml.
POSTGRES_DB=mds
POSTGRES_USER=mds_user
POSTGRES_PASSWORD=

# Redis memory limit for the redis container (Docker Compose only).
# Uses Redis maxmemory notation: 256mb, 512mb, 1gb, etc.
REDIS_MAX_MEMORY=512mb


# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
# The circuit breaker prevents cascading failures by stopping requests to
# a provider that has recently failed repeatedly.
# State machine: CLOSED → OPEN (after threshold failures) → HALF_OPEN (after
# recovery window) → CLOSED (on successful probe).
# Redis-backed state is shared across all API replicas.

# Number of consecutive failures required to open the circuit.
# Valid range: 1–100. A lower value is more aggressive.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds before an OPEN circuit transitions to HALF_OPEN for a probe request.
# Valid range: 1–3600.
CIRCUIT_BREAKER_RECOVERY_WINDOW_SEC=60


# =============================================================================
# CACHE
# =============================================================================

# Maximum number of entries in the L1 in-process LRU cache.
# Each entry is approximately 1 KB. Increase for higher-throughput deployments.
# The LRU evicts the least-recently-used entry when the limit is reached.
CACHE_L1_MAX_ENTRIES=10000


# =============================================================================
# PROVIDER GATEWAY
# =============================================================================

# Maximum number of queued requests per provider × capability pair.
# Overflow returns PROVIDER_QUEUE_FULL (HTTP 503) immediately.
# Valid range: 1–10000.
PROVIDER_QUEUE_MAX_DEPTH=100


# =============================================================================
# GAP RECOVERY
# =============================================================================
# When the validation pipeline detects a missing candle sequence (a "gap"),
# the gap recovery engine automatically attempts to backfill the missing data.

# Maximum number of automated gap-recovery attempts before marking EXHAUSTED.
# Exhausted gaps are retained in the database for manual review and emit a
# DataIncident record. Valid range: 1–10.
GAP_RECOVERY_MAX_ATTEMPTS=5


# =============================================================================
# BACKFILL CHUNK SIZES (calendar days per chunk)
# =============================================================================
# When fetching historical OHLCV data, large date ranges are split into
# chunks to stay within each provider's date-range limits.
# Reducing these values results in more API calls but smaller individual payloads.

# Angel One SmartAPI — 1m interval (max 30 days per API call)
BACKFILL_CHUNK_ANGEL_1M_DAYS=30

# Angel One SmartAPI — 5m and 15m intervals (both capped at 90 days)
BACKFILL_CHUNK_ANGEL_5M_15M_DAYS=90

# Upstox V3 — 1m interval (max 7 days per API call)
BACKFILL_CHUNK_UPSTOX_1M_DAYS=7

# Upstox V3 — 5m and 15m intervals (both capped at 30 days)
BACKFILL_CHUNK_UPSTOX_5M_15M_DAYS=30

# Upstox V3 — 1d interval (up to 365 days per API call)
BACKFILL_CHUNK_UPSTOX_1D_DAYS=365


# =============================================================================
# OBSERVABILITY
# =============================================================================

# OpenTelemetry span exporter.
# noop   — discard all spans (local development)
# jaeger — export to Jaeger (set JAEGER_AGENT_HOST / JAEGER_AGENT_PORT)
# otlp   — export via OTLP gRPC (production, set OTEL_EXPORTER_OTLP_ENDPOINT)
# Values: noop | jaeger | otlp
OTEL_EXPORTER=noop

# Structured log level. Affects all structlog and stdlib logging output.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# =============================================================================
# SECURITY
# =============================================================================

# Comma-separated list of allowed CORS origins.
# Wildcard (*) is PROHIBITED on all endpoints (Requirement 19.6).
# Leave empty only for local development where CORS is not relevant.
# Example (production): https://app.alphaforge.in,https://staging.alphaforge.in
# Example (local dev):  http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Secrets backend. Controls how provider credentials are loaded.
# env          — read from OS environment variables (default)
# vault        — HashiCorp Vault (requires additional Vault configuration)
# aws_secrets  — AWS Secrets Manager (requires IAM role)
SECRETS_BACKEND=env


# =============================================================================
# CONSUMER AUTHENTICATION
# =============================================================================
# DATA-SERVICE 2.0 supports two authentication methods for all /v1/* data routes:
#   1. API Key:    X-API-KEY: <key>           (simplest, no expiry)
#   2. JWT Bearer: Authorization: Bearer <token>  (obtained via /v1/auth/token)

# HS256 signing secret for consumer JWTs. REQUIRED.
# Must be a strong random string of at least 32 characters.
# Generate a secure value: openssl rand -hex 32
# WARNING: the placeholder value below is for local dev only. Change it.
JWT_SECRET=

# JWT token lifetime in seconds.
# Production default: 3600 (1 hour).
# Local dev default:  86400 (24 hours) — set in .env.local.
JWT_EXPIRY_SECONDS=3600

# Comma-separated list of valid API keys for consumer access. REQUIRED.
# Consumers use these via the X-API-KEY header, or exchange them for a JWT
# via GET /v1/auth/token?api_key=<key>.
# Example: key-consumer-alphaforge,key-consumer-internal-worker
CONSUMER_API_KEYS=


# =============================================================================
# PROVIDER CREDENTIALS
# =============================================================================
# All values below are secrets — never commit them to version control.
# In production, prefer injecting them from a secrets manager
# (SECRETS_BACKEND=vault or SECRETS_BACKEND=aws_secrets).
#
# The service degrades gracefully when credentials are absent:
# - Angel One absent → live quotes and option chain return null values
# - Upstox absent    → Upstox historical data unavailable; fallback to other providers
# - Binance absent   → public endpoints still work (no auth needed for public data)
# - Delta absent     → public endpoints still work


# --- Angel One SmartAPI ---
# Obtain from the Angel One developer portal: https://smartapi.angelbroking.com
#
# ANGEL_ONE_API_KEY    — your SmartAPI application key
# ANGEL_ONE_CLIENT_ID  — your Angel One broker login ID (e.g. M495775)
# ANGEL_ONE_TOTP_SECRET — Base32-encoded TOTP seed from the SmartAPI portal.
#                         Handle with extreme care — exposure allows full account access.
# ANGEL_ONE_MPIN       — 4-digit broker login PIN (MPIN) registered with Angel One.
#                         Required for TOTP + JWT authentication flow.
#
# Known limitation: Angel One 1m historical data is not available for some
# instruments outside market hours. Use Upstox as the primary 1m provider.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_TOTP_SECRET=
ANGEL_ONE_MPIN=


# --- Upstox V3 ---
# Obtain from: https://developer.upstox.com
#
# UPSTOX_API_KEY        — Upstox application key
# UPSTOX_API_SECRET     — Upstox application secret
# UPSTOX_REDIRECT_URI   — Must match the redirect URI registered in the Upstox developer console.
# UPSTOX_ACCESS_TOKEN   — Pre-obtained OAuth2 access token.
#                         Upstox tokens expire daily. Refresh via the Upstox developer
#                         console and update this value. The scheduler does NOT auto-rotate
#                         Upstox tokens (only Angel One JWT is auto-rotated at 23:55 IST).
# UPSTOX_ANALYTICS_KEY  — Long-lived JWT for Upstox analytics endpoints (PCR, OI, gainers/losers).
#                         Different from the OAuth access token — issued separately.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8200/v1/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_KEY=


# =============================================================================
# BINANCE CONFIGURATION
# =============================================================================
# Public market-data endpoints (klines, ticker, exchange-info, 24hr stats,
# mark price, funding rate, OI, L/S ratio) require NO credentials.
# Only set BINANCE_API_KEY / BINANCE_API_SECRET if you need authenticated
# private endpoints (account, order management) — not needed for this service.

# Spot REST base URL (klines, ticker, exchangeInfo, 24hr stats)
BINANCE_REST_BASE_URL=https://api.binance.com

# USDM Futures REST (mark price, funding rate, OI, L/S ratio)
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Spot WebSocket stream base (real-time ticks, mini-ticker)
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# Futures WebSocket stream base (mark price, funding, liquidation streams)
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com

# Optional — only for private Binance endpoints. Leave blank for this service.
BINANCE_API_KEY=
BINANCE_API_SECRET=


# =============================================================================
# DELTA EXCHANGE CONFIGURATION
# =============================================================================
# AlphaForge uses Delta Exchange India for crypto spot/perpetuals.
# Public endpoints (products, orderbook, candles, tickers) require NO credentials.
#
# Key Delta Exchange differences vs Binance:
#   - Symbols use USD suffix, not USDT: BTCUSD, ETHUSD, SOLUSD
#   - Candles are returned in descending order (newest first); the adapter sorts ascending
#   - Time field is Unix seconds (not ms); the adapter converts to ms for canonical consistency
#   - India endpoint: api.india.delta.exchange
#   - No global L/S ratio endpoint on Delta India (returns empty list)

# India region REST base URL (default for AlphaForge)
# For global (non-India) deployments: https://api.delta.exchange
DELTA_REST_BASE_URL=https://api.india.delta.exchange

# Delta Exchange WebSocket base URL
DELTA_WS_BASE_URL=wss://socket.india.delta.exchange

# Optional — only for private Delta endpoints. Leave blank for public market data.
DELTA_API_KEY=
DELTA_API_SECRET=
