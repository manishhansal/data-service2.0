# =============================================================================
# DATA-SERVICE 2.0 — Environment Variable Reference
# Requirements: 20.7, 19.1
#
# Copy this file to .env and fill in all required values marked below.
# NEVER commit .env to version control — it contains secrets.
#
#   cp .env.example .env
#
# Lines beginning with # are comments.
# Lines with no default value (empty after =) are REQUIRED in production.
# =============================================================================


# =============================================================================
# SERVER
# =============================================================================

# Port the FastAPI/Uvicorn process listens on inside the container.
# The docker-compose.yml maps this to the host as ${DATA_SERVICE_PORT}:8200.
DATA_SERVICE_PORT=8200

# Deployment environment. Controls whether /docs, /redoc, /openapi.json are
# exposed (development/staging only) and log output format.
# Values: development | staging | production
ENVIRONMENT=production

# Number of Uvicorn worker processes. Set to 1 for debugging.
UVICORN_WORKERS=4


# =============================================================================
# INFRASTRUCTURE
# =============================================================================

# Redis connection string.
# The data-service network alias "redis" resolves inside Docker Compose.
REDIS_URL=redis://redis:6379/0

# PostgreSQL async connection string. REQUIRED — no default.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# PostgreSQL container credentials (used to construct DATABASE_URL inside
# docker-compose.yml and for pg_isready healthcheck).
POSTGRES_DB=mds
POSTGRES_USER=mds_user
# REQUIRED — set a strong password before first deploy.
POSTGRES_PASSWORD=

# Redis memory limit for the redis container (Docker Compose only).
# Uses Redis maxmemory notation: 256mb, 512mb, 1gb, etc.
REDIS_MAX_MEMORY=512mb


# =============================================================================
# CIRCUIT BREAKER
# =============================================================================

# Number of failures within a rolling window before the circuit opens.
# Valid range: 1–100.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds before an OPEN circuit transitions to HALF_OPEN for a probe request.
# Valid range: 1–3600.
CIRCUIT_BREAKER_RECOVERY_WINDOW_SEC=60


# =============================================================================
# CACHE
# =============================================================================

# Maximum number of entries in the L1 in-process LRU cache.
# Increase for higher-throughput deployments; each entry is ~1KB.
CACHE_L1_MAX_ENTRIES=10000


# =============================================================================
# PROVIDER GATEWAY
# =============================================================================

# Maximum number of queued requests per provider × capability pair.
# Overflow returns PROVIDER_QUEUE_FULL immediately.
# Valid range: 1–10000.
PROVIDER_QUEUE_MAX_DEPTH=100


# =============================================================================
# GAP RECOVERY
# =============================================================================

# Maximum number of automated gap-recovery attempts before marking EXHAUSTED.
# Valid range: 1–10.
GAP_RECOVERY_MAX_ATTEMPTS=5


# =============================================================================
# BACKFILL CHUNK SIZES (calendar days per chunk)
# =============================================================================

# Angel One SmartAPI — 1m interval
BACKFILL_CHUNK_ANGEL_1M_DAYS=30

# Angel One SmartAPI — 5m and 15m intervals (shared limit)
BACKFILL_CHUNK_ANGEL_5M_15M_DAYS=90

# Upstox V3 — 1m interval
BACKFILL_CHUNK_UPSTOX_1M_DAYS=7

# Upstox V3 — 5m and 15m intervals (shared limit)
BACKFILL_CHUNK_UPSTOX_5M_15M_DAYS=30

# Upstox V3 — 1d interval
BACKFILL_CHUNK_UPSTOX_1D_DAYS=365


# =============================================================================
# OBSERVABILITY
# =============================================================================

# OpenTelemetry span exporter.
# Values: noop | jaeger | otlp
# Use "noop" for local development; "otlp" for production with a collector.
OTEL_EXPORTER=noop

# Log level.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# =============================================================================
# SECURITY
# =============================================================================

# Comma-separated list of allowlisted CORS origins.
# Wildcard (*) is prohibited on all endpoints (Requirement 19.6).
# Example: https://app.alphaforge.in,https://staging.alphaforge.in
# REQUIRED in production — leave empty only for local development.
CORS_ALLOWED_ORIGINS=

# Secrets backend. Values: env | vault | aws_secrets
# "env" reads credentials from the environment variables below.
# "vault" and "aws_secrets" require additional backend-specific configuration.
SECRETS_BACKEND=env


# =============================================================================
# CONSUMER AUTHENTICATION
# Requirements: 19.2 — Task 13.2
# =============================================================================

# HS256 signing secret for consumer JWTs.
# REQUIRED — use a strong random string (≥ 32 characters) in production.
# Example: openssl rand -hex 32
JWT_SECRET=

# JWT token lifetime in seconds (default 3600 = 1 hour).
JWT_EXPIRY_SECONDS=3600

# Comma-separated list of valid API keys for consumer access.
# Consumers present these via the X-API-KEY header or exchange them for a JWT
# via GET /v1/auth/token?api_key=<key>.
# REQUIRED in production — leave empty only for local/no-auth development.
# Example: key-consumer-1,key-consumer-2
CONSUMER_API_KEYS=


# =============================================================================
# PROVIDER CREDENTIALS
# All values below are secrets — never commit them to version control.
# In production, prefer injecting them from a secrets manager
# (SECRETS_BACKEND=vault or SECRETS_BACKEND=aws_secrets).
# =============================================================================

# --- Angel One SmartAPI ---
# Obtain from the Angel One developer portal (https://smartapi.angelbroking.com).
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
# Base32-encoded TOTP seed (used to generate time-based OTPs for login).
# Handle with extreme care — exposure allows full account access.
ANGEL_ONE_TOTP_SECRET=

# --- Upstox V2/V3 ---
# Obtain from the Upstox developer portal (https://developer.upstox.com).
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must match the redirect URI registered in the Upstox developer console.
UPSTOX_REDIRECT_URI=https://localhost:8200/v1/auth/upstox/callback

# =============================================================================
# CRYPTO PROVIDER CONFIGURATION
# =============================================================================
# All base URLs below default to the official public endpoints.
# Override only if you need to point at testnet, a proxy, or the
# India-specific Delta Exchange endpoint.
#
# PUBLIC endpoints (klines, ticker, orderbook, products) need NO credentials.
# Set API keys only if you need authenticated (private) endpoints.
# =============================================================================

# --- Binance ---
# Spot REST base URL (public: klines, ticker, exchangeInfo, 24hr stats)
BINANCE_REST_BASE_URL=https://api.binance.com
# USDM Futures REST base URL (mark price, funding rate, OI, L/S ratio)
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# Spot WebSocket stream base
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
# Futures WebSocket stream base
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com

# Optional — only needed for private Binance endpoints (account, orders).
# Leave blank for public-only market-data usage.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Delta Exchange ---
# India region REST base URL (default for this project)
# For global (non-India) deployments use https://api.delta.exchange instead.
DELTA_REST_BASE_URL=https://api.india.delta.exchange
# WebSocket base URL
DELTA_WS_BASE_URL=wss://socket.india.delta.exchange

# Optional — only needed for private Delta Exchange endpoints.
# Leave blank for public-only market-data usage.
DELTA_API_KEY=
DELTA_API_SECRET=
